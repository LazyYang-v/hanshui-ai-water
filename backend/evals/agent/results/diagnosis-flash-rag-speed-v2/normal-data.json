          "sql": "WITH r AS (SELECT pr.ts, pr.nh3n_out, pr.tp_out, pr.do_aerobic_1 FROM plant_reading AS pr JOIN plant AS p ON p.id = pr.plant_id WHERE p.code = 'P01' AND pr.ts = CAST('2026-11-02 12:00:00+08:00' AS TIMESTAMPTZ) ORDER BY pr.ts DESC LIMIT 1) SELECT 'P01' AS 厂站编码, v.指标名称, r.ts AS 采样时间, ROUND(CAST(v.数值 AS DECIMAL), 3) AS 数值_mgL FROM r CROSS JOIN LATERAL (VALUES ('出水氨氮', r.nh3n_out), ('出水总磷', r.tp_out), ('好氧区1#DO', r.do_aerobic_1)) AS v(指标名称, 数值) LIMIT 200",
