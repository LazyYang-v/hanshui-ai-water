          "sql": "WITH t(target) AS (SELECT * FROM (VALUES (CAST('2026-11-05 16:00:00+08' AS TIMESTAMPTZ)), (CAST('2026-11-06 16:00:00+08' AS TIMESTAMPTZ))) AS _values) SELECT p.code AS 厂站编码, t.target AS 时间, ROUND(CAST(r.carbon_dose_kgh AS DECIMAL), 2) AS carbon_dose_kgh, ROUND(CAST(r.inflow_m3h AS DECIMAL), 2) AS inflow_m3h, ROUND(CAST(r.tn_out AS DECIMAL), 2) AS tn_out FROM t CROSS JOIN plant AS p LEFT JOIN LATERAL (SELECT x.* FROM plant_reading AS x WHERE x.plant_id = p.id AND x.ts >= t.target - INTERVAL '10 MINUTES' AND x.ts <= t.target + INTERVAL '10 MINUTES' ORDER BY ABS(EXTRACT(EPOCH FROM (x.ts - t.target))) LIMIT 1) AS r ON TRUE WHERE p.code = 'P05' ORDER BY t.target LIMIT 200",
