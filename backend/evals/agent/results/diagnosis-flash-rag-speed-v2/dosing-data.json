          "provider": "deepseek",
          "model": "deepseek-flash",
          "sql": "WITH tp AS (SELECT id, code FROM plant WHERE code = 'P02' AND name LIKE '%协税镇%'), tgt AS (SELECT CAST('2026-11-05 14:00:00+08' AS TIMESTAMPTZ) AS t), pr AS (SELECT tp.code AS 厂站编码, CAST(NULL AS TEXT) AS 设备编码, r.ts AS 采样时间, CAST('出水总磷' AS TEXT) AS 指标, CAST('mg/L' AS TEXT) AS 单位, ROUND(CAST(r.tp_out AS DECIMAL), 3) AS 数值 FROM tp CROSS JOIN tgt CROSS JOIN LATERAL (SELECT ts, tp_out FROM plant_reading WHERE plant_id = tp.id AND ts BETWEEN tgt.t - INTERVAL '10 MINUTES' AND tgt.t + INTERVAL '10 MINUTES' ORDER BY ABS(EXTRACT(EPOCH FROM (ts - tgt.t))) LIMIT 1) AS r UNION ALL SELECT tp.code, CAST(NULL AS TEXT), r.ts, 'PAC投加量', 'kg/h', ROUND(CAST(r.pac_dose_kgh AS DECIMAL), 2) FROM tp CROSS JOIN tgt CROSS JOIN LATERAL (SELECT ts, pac_dose_kgh FROM plant_reading WHERE plant_id = tp.id AND ts BETWEEN tgt.t - INTERVAL '10 MINUTES' AND tgt.t + INTERVAL '10 MINUTES' ORDER BY ABS(EXTRACT(EPOCH FROM (ts - tgt.t))) LIMIT 1) AS r), dr AS (SELECT tp.code AS 厂站编码, d.code AS 设备编码, x.ts AS 采样时间, CAST('电流' AS TEXT) AS 指标, CAST('A' AS TEXT) AS 单位, ROUND(CAST(x.current_a AS DECIMAL), 2) AS 数值 FROM tp JOIN device AS d ON d.plant_id = tp.id AND d.code = 'P02-DP-P' CROSS JOIN tgt CROSS JOIN LATERAL (SELECT ts, current_a, vibration_mms FROM device_reading WHERE device_id = d.id AND ts BETWEEN tgt.t - INTERVAL '10 MINUTES' AND tgt.t + INTERVAL '10 MINUTES' ORDER BY ABS(EXTRACT(EPOCH FROM (ts - tgt.t))) LIMIT 1) AS x UNION ALL SELECT tp.code, d.code, x.ts, '振动', 'mm/s', ROUND(CAST(x.vibration_mms AS DECIMAL), 2) FROM tp JOIN device AS d ON d.plant_id = tp.id AND d.code = 'P02-DP-P' CROSS JOIN tgt CROSS JOIN LATERAL (SELECT ts, current_a, vibration_mms FROM device_reading WHERE device_id = d.id AND ts BETWEEN tgt.t - INTERVAL '10 MINUTES' AND tgt.t + INTERVAL '10 MINUTES' ORDER BY ABS(EXTRACT(EPOCH FROM (ts - tgt.t))) LIMIT 1) AS x) SELECT 厂站编码, 设备编码, 采样时间, 指标, 单位, 数值 FROM (SELECT * FROM pr UNION ALL SELECT * FROM dr) AS s ORDER BY 指标, 采样时间 LIMIT 200",
          "explanation": "按厂站编码 P02 与设备编码 P02-DP-P 定位，用 LATERAL 分别在 2026-11-05 14:00 前后 10 分钟内取最接近该时刻的一条原始采样，逐项返回出水总磷、PAC 投加量及电流、振动原值并保留各自采样时间，不使用台账字段代替。",
