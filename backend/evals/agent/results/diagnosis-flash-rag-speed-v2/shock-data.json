          "sql": "WITH times(ts) AS (SELECT * FROM (VALUES (CAST('2026-11-03 10:00:00+08' AS TIMESTAMPTZ)), (CAST('2026-11-04 10:00:00+08' AS TIMESTAMPTZ))) AS _values), p AS (SELECT id, code FROM plant WHERE code = 'P04') SELECT p.code AS 厂站编码, t.ts AS 采样时间, CASE WHEN r.ts IS NULL THEN '缺失' ELSE CAST(ROUND(CAST(r.inflow_m3h AS DECIMAL), 2) AS TEXT) END AS 进水流量_m3h, CASE WHEN r.ts IS NULL THEN '缺失' ELSE CAST(ROUND(CAST(r.cod_in AS DECIMAL), 2) AS TEXT) END AS 进水COD_mgL, CASE WHEN r.ts IS NULL THEN '缺失' ELSE CAST(ROUND(CAST(r.nh3n_in AS DECIMAL), 2) AS TEXT) END AS 进水氨氮_mgL FROM times AS t CROSS JOIN p LEFT JOIN LATERAL (SELECT pr.ts, pr.inflow_m3h, pr.cod_in, pr.nh3n_in FROM plant_reading AS pr WHERE pr.plant_id = p.id AND pr.ts = t.ts ORDER BY pr.ts LIMIT 1) AS r ON TRUE ORDER BY t.ts LIMIT 200",
