          "provider": "deepseek",
          "model": "deepseek-flash",
          "sql": "WITH b AS (SELECT CAST('2026-11-05 12:00:00+08:00' AS TIMESTAMPTZ) AS t_start, CAST('2026-11-05 16:00:00+08:00' AS TIMESTAMPTZ) AS t_end), pl AS (SELECT p.code AS 厂站编码, p.name AS 厂站名称, CAST('—' AS TEXT) AS 设备编码, h.hour AS 采样时间, u.指标, u.数值, u.单位 FROM plant_reading_1h AS h JOIN plant AS p ON p.id = h.plant_id CROSS JOIN b CROSS JOIN LATERAL (VALUES ('出水总磷(原始小时值)', ROUND(CAST(h.tp_out AS DECIMAL), 3), 'mg/L'), ('PAC投加量', ROUND(CAST(h.pac_dose_kgh AS DECIMAL), 2), 'kg/h')) AS u(指标, 数值, 单位) WHERE p.code = 'P02' AND h.hour >= b.t_start AND h.hour <= b.t_end), da AS (SELECT p.code AS plant_code, p.name AS plant_name, d.code AS device_code, DATE_TRUNC('HOUR', r.ts) AS hour, AVG(r.current_a) AS cur, AVG(r.vibration_mms) AS vib FROM device_reading AS r JOIN device AS d ON d.id = r.device_id JOIN plant AS p ON p.id = d.plant_id CROSS JOIN b WHERE d.code = 'P02-DP-P' AND r.ts >= b.t_start AND r.ts <= b.t_end GROUP BY 1, 2, 3, 4), dv AS (SELECT plant_code AS 厂站编码, plant_name AS 厂站名称, device_code AS 设备编码, hour AS 采样时间, u.指标, u.数值, u.单位 FROM da CROSS JOIN LATERAL (VALUES ('设备电流(P02-DP-P)', ROUND(CAST(cur AS DECIMAL), 2), 'A'), ('设备振动(P02-DP-P)', ROUND(CAST(vib AS DECIMAL), 2), 'mm/s')) AS u(指标, 数值, 单位)) SELECT t.厂站编码, t.厂站名称, t.设备编码, t.指标, t.数值, t.单位, t.采样时间, CASE WHEN t.采样时间 = CAST('2026-11-05 14:00:00+08:00' AS TIMESTAMPTZ) THEN '★重点关注' ELSE '' END AS 备注 FROM (SELECT * FROM pl UNION ALL SELECT * FROM dv) AS t ORDER BY (t.采样时间 = CAST('2026-11-05 14:00:00+08:00' AS TIMESTAMPTZ)) DESC, t.采样时间, t.厂站编码, t.设备编码, t.指标 LIMIT 200",
          "explanation": "以 P02 厂在 2026-11-05 12:00~16:00 的整点小时为时间轴：从 plant_reading_1h 取该厂小时出水总磷(tp_out)与 PAC 投加量，从 device_reading 按小时聚合 P02-DP-P（PAC 加药泵）的电流均值与振动均值，用 UNION ALL 统一成长表并保留厂站编码、设备编码、指标、数值、单位与采样时间，14:00 的记录排在最前并标注重点关注。",
