          "sql": "WITH target AS (SELECT CAST('2026-11-05 14:00:00+08' AS TIMESTAMPTZ) AS ts), pr AS (SELECT r.ts, r.tp_out, r.pac_dose_kgh FROM plant_reading AS r JOIN plant AS p ON p.id = r.plant_id CROSS JOIN target AS t WHERE p.code = 'P02' ORDER BY (r.ts = t.ts) DESC, ABS(EXTRACT(EPOCH FROM (r.ts - t.ts))) LIMIT 1), dr AS (SELECT r.ts, r.current_a, r.vibration_mms FROM device_reading AS r JOIN device AS d ON d.id = r.device_id CROSS JOIN target AS t WHERE d.code = 'P02-DP-P' ORDER BY (r.ts = t.ts) DESC, ABS(EXTRACT(EPOCH FROM (r.ts - t.ts))) LIMIT 1) SELECT 'P02' AS 厂站编码, CAST(NULL AS TEXT) AS 设备编码, '出水总磷' AS 指标名称, pr.tp_out AS 数值, 'mg/L' AS 单位, pr.ts AS 采样时间 FROM pr UNION ALL SELECT 'P02', NULL, 'PAC投加量', pr.pac_dose_kgh, 'kg/h', pr.ts FROM pr UNION ALL SELECT 'P02', 'P02-DP-P', '运行电流', dr.current_a, 'A', dr.ts FROM dr UNION ALL SELECT 'P02', 'P02-DP-P', '振动速度', dr.vibration_mms, 'mm/s', dr.ts FROM dr LIMIT 200",
