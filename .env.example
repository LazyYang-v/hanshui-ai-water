# 复制为 .env 后按需修改
POSTGRES_PASSWORD=shuiwu
TEXT2SQL_RO_PASSWORD=readonly
DB_PORT=15432
REDIS_PORT=16379
BACKFILL_DAYS=7
API_PORT=8000
# 前端（nginx）端口；它同源代理 /api 和 /ws，CORS 只在 npm run dev 直连 api 时需要
WEB_PORT=15173
CORS_ORIGINS=http://localhost:5173

# LLM 网关：主用 + 备用（逗号分隔，按顺序降级）；可选 deepseek / qwen / ollama
LLM_PROVIDERS=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
QWEN_API_KEY=
# 每个厂商的在途请求上限（0 不限）；厂商有固定并发配额时设为配额，超出在网关排队而不是收到 429
LLM_MAX_CONCURRENCY=0

# RAG：中文向量在本机 CPU 上运行；先执行 python -m app.ai.rag.build 下载模型
# 服务启动不自动下载；模型未就绪时 hybrid 明确降级为 BM25
RAG_DENSE_ENABLED=true

# 管理员账号（唯一账号）：查看页面无需登录；写入、调用模型、注入场景需要登录
# 密码留空则无法登录，写接口一律 401；生成随机密码：python3 -c "import secrets; print(secrets.token_urlsafe(12))"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# 通过 HTTPS 部署时改为 true
COOKIE_SECURE=false
